[Unit]
Description=WISE site + on-page comment API (port 4144)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wisealliance/server
# The site itself is served from the git checkout, so a `git pull` is still the
# whole deploy. Comments live outside the checkout so pulling never touches them.
Environment=WISE_FEEDBACK_STATIC=/home/ubuntu/wisealliance
Environment=WISE_FEEDBACK_DB=/home/ubuntu/wise-feedback/comments.db
EnvironmentFile=/home/ubuntu/wise-feedback/secret.env
ExecStart=/home/ubuntu/wise-feedback/venv/bin/gunicorn \
    --workers 2 \
    --threads 4 \
    --bind 0.0.0.0:4144 \
    feedback_api:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
